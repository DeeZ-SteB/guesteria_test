{
  "name": "guesteria-stay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8700",
    "build": "next build",
    "start": "next start -p 8700",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "docker:up": "docker compose up -d --build web",
    "docker:dev": "docker compose --profile dev up web-dev",
    "docker:down": "docker compose down",
    "demo:ensure": "node --env-file=.env scripts/ensure-demo-user.mjs",
    "liteapi:check-cities": "node --env-file=.env scripts/check-cities.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:live": "E2E_LIVE=1 playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "server-only": "^0.0.1",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
