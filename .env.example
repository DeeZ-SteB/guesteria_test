# Copy to .env and fill in. Local Supabase keys come from `npm run db:status`.

# Browser-visible (inlined at build time). The publishable key is safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8721
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
LITEAPI_KEY=
ANTHROPIC_API_KEY=

# Only for the Docker containers: how the server reaches Supabase on the host.
# Set automatically in docker-compose.yml.
# SUPABASE_INTERNAL_URL=http://host.docker.internal:8721
